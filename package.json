{
  "name": "herdr-axi",
  "version": "0.4.0",
  "description": "Agent-ergonomic CLI for herdr fleet supervision and orchestration",
  "author": "maccie01",
  "repository": { "type": "git", "url": "git+https://github.com/maccie01/herdr-axi.git" },
  "homepage": "https://github.com/maccie01/herdr-axi#readme",
  "bugs": { "url": "https://github.com/maccie01/herdr-axi/issues" },
  "type": "module",
  "bin": { "herdr-axi": "bin/herdr-axi.mjs" },
  "files": ["bin", "src", "engine", "docs", "!engine/test-herdr-monitor.sh", "!engine/test/**"],
  "engines": { "node": ">=20", "herdr": ">=0.9.0" },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
